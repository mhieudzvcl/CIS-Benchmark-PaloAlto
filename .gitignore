# ============================================================
# Git Ignore Configuration - CIS Palo Alto Security Auditor
# ============================================================

# Python & Virtual Environments
.venv/
venv/
ENV/
env/
__pycache__/
.pytest_cache/
*.py[cod]
*.pyc

# Local Scratch, Temporary Scripts & Raw Notes
scratch/
*.tmp
*.bak
*.swp
*~

# LaTeX Documents, PDFs & Build Artifacts (Kept local, excluded from Git)
*.pdf
*.tex
docs/*.pdf
docs/*.tex
docs/report_*
docs/DEMO_KICH_BAN.md
docs/cis_*.txt
docs/images/
*.aux
*.toc
*.lof
*.lot
*.lol
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.log

# Sensitive Credentials, API Keys & Certificates
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
*.xml.secret

# Firewall Config Backups, Reports & Evidence
configs/*
!configs/.gitkeep
reports/*
!reports/.gitkeep
evidence/*
!evidence/.gitkeep

# OS-specific files
.DS_Store
Thumbs.db
desktop.ini
